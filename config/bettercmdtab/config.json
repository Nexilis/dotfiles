{
  "$schema" : "schema.json",
  "animationsEnabled" : false,
  "appExceptions" : [
    {
      "bundleID" : "com.apple.finder",
      "hide" : "whenNoWindows",
      "ignore" : "never"
    }
  ],
  "applicationsOnly" : true,
  "boldSelectedLabel" : true,
  "commitSoundName" : "Tink",
  "cycleTileWidths" : true,
  "expandBrowserTabsAsWindows" : false,
  "experimentalInstantSpaceSwitch" : false,
  "fontFace" : "system",
  "fontScale" : "standard",
  "gridSingleRow" : true,
  "hideMenuBarIcon" : true,
  "instantSpaceSwitch" : false,
  "layoutMode" : "iconDock",
  "nextScopedShortcutID" : 0,
  "panelOpacity" : 100,
  "panelScalePercent" : 75,
  "previewTitleAlignment" : "center",
  "revealDelayMs" : 40,
  "scopedShortcutList" : [

  ],
  "shortcutOverrides" : [
    {
      "showHidden" : "false",
      "showMinimized" : "true",
      "showWindowless" : "false",
      "sortOrder" : "mru",
      "spaceScope" : "allSpaces",
      "stayOpenOnQuickTap" : "true",
      "stayOpenOnRelease" : "true",
      "target" : "switchApps"
    }
  ],
  "showApplicationNames" : true,
  "showHiddenApps" : false,
  "showRecentlyClosed" : false,
  "showWindowlessApps" : false,
  "showWindowStatusIcons" : true,
  "showWindowTitleLabel" : false,
  "sortOrder" : "mru",
  "soundOnCommit" : true,
  "tabDrillEnabled" : false,
  "titleTruncationMode" : "middle",
  "windowDrillEnabled" : false
}