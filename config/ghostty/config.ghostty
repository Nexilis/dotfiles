theme = Smyck
# Login shell stays zsh; Ghostty starts nushell. Absolute path, because a
# Dock-launched app does not have Homebrew on PATH.
command = /opt/homebrew/bin/nu
# toggle-theme.sh (Hyper+T) writes theme-override to switch to light.
config-file = ?theme-override
# Reopen the last windows, tabs and splits on every launch.
window-save-state = always
# Left Option sends Alt (nchat and nushell shortcuts); right Option still types
# Polish letters (Polish Pro layout).
macos-option-as-alt = left
