From 8979d0f312a518f978dd7d4539203bbf5e391f5d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bartek=20=C5=81ukasik?= <Nexilis@users.noreply.github.com>
Date: Wed, 18 Nov 2026 10:31:25 +0100
Subject: [PATCH] Use hash routing so the build runs from local files

Pake and other file-based wrappers serve the dist folder without a
history-mode fallback, so /editor does not resolve. HashRouter keeps
every route inside index.html; hand-built links and window.open calls
use /#/ paths, and query parameters come from the router location.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/App.jsx                                  |  6 +++---
 src/components/EditorHeader/ControlPanel.jsx | 11 ++++++-----
 src/components/EditorHeader/Modal/Share.jsx  |  2 +-
 src/hooks/useNavigateWithParams.js           |  7 ++++---
 src/pages/Templates.jsx                      |  2 +-
 5 files changed, 15 insertions(+), 13 deletions(-)

diff --git a/src/App.jsx b/src/App.jsx
index 9ae9334..6645c78 100644
--- a/src/App.jsx
+++ b/src/App.jsx
@@ -1,4 +1,4 @@
-import { BrowserRouter, Routes, Route, useLocation } from "react-router-dom";
+import { HashRouter, Routes, Route, useLocation } from "react-router-dom";
 import { useLayoutEffect } from "react";
 import Editor from "./pages/Editor";
 import BugReport from "./pages/BugReport";
@@ -22,7 +22,7 @@ export default function App() {
   );
 
   return (
-    <BrowserRouter>
+    <HashRouter>
       <SettingsContextProvider>
