# These config dirs are symlinked into this repo, so the apps read and write
# their state inside the repo working tree. Keep machine-generated and personal
# state out of git while letting it live alongside the tracked config.

# fish: universal variables + generated completions and tool integrations
config/fish/fish_variables
config/fish/completions/
config/fish/conf.d/

# nvim: plugin lockfile (noise, regenerated by lazy.nvim)
config/nvim/lazy-lock.json

# hammerspoon: installed Spoons (plugins)
config/hammerspoon/Spoons/

# zed: chats, prompts, downloaded themes, settings backups
config/zed/conversations/
config/zed/prompts/
config/zed/themes/
config/zed/settings_backup.json

# bettercmdtab: the sidecar JSON Schema, regenerated from the running build at
# every launch, so it would churn on each app update. The app rewrites it when
# absent, which is what a fresh clone gets.
config/bettercmdtab/schema.json

# karabiner: generated assets and automatic backups
config/karabiner/assets/
config/karabiner/automatic_backups/

# maki: track only init.lua; keep any state/creds maki may write here out of git
config/maki/*
!config/maki/init.lua

# Stray Claude Code local state that lands in a working directory. The pattern is
# unanchored on purpose: this state shows up at the repo root and inside config
# dirs (config/hammerspoon/.claude/), so it has to match at any depth.
.claude/
.claude.json

# ...but home/.claude/ is OURS: it mirrors ~/.claude and carries the custom
# themes, which are tracked config, not state. Re-include it. The directory
# itself has to be un-ignored first, otherwise git never descends into it and any
# negation for the files inside is dead.
!home/.claude/
!home/.claude/themes/

# tk tickets: local task state, not committed (any .tickets dir, at any level)
.tickets/

# OS noise
.DS_Store
